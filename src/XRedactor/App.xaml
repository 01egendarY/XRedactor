<Application x:Class="XRedactor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#17161B" po:Freeze="False" />
        <SolidColorBrush x:Key="PanelBackground" Color="#211F26" po:Freeze="False" />
        <SolidColorBrush x:Key="PanelRaised" Color="#2A2830" po:Freeze="False" />
        <SolidColorBrush x:Key="WorkspaceBackground" Color="#111015" po:Freeze="False" />
        <SolidColorBrush x:Key="PlaneWorldBackground" Color="#15141A" po:Freeze="False" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F5F1EB" po:Freeze="False" />
        <SolidColorBrush x:Key="SecondaryText" Color="#A9A4AD" po:Freeze="False" />
        <SolidColorBrush x:Key="Accent" Color="#D85050" po:Freeze="False" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
            <Setter Property="BorderBrush" Value="#46424D" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#242128" />
            <Setter Property="Background" Value="#F5F1EB" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="3" />
        </Style>
    </Application.Resources>
</Application>
